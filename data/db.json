  "universal": {
    "resumeUrl": "https://raw.githubusercontent.com/codemdragon/Portfolio_future/main/assets/resume/Resume.pdf",
    "formspreeUrl": "https://formspree.io/f/xdaprdja",
    "resumeHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Resume - Muhammad Haji</title>\n    <style>\n        :root {\n            --primary-color: #2563eb;\n            --text-color: #1f2937;\n            --text-muted: #6b7280;\n            --bg-color: #f3f4f6;\n            --card-bg: #ffffff;\n            --border-color: #e5e7eb;\n            --font-main: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: var(--font-main);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            display: flex;\n            justify-content: center;\n            padding: 40px 20px;\n            min-height: 100vh;\n        }\n\n        .resume-container {\n            background-color: var(--card-bg);\n            width: 100%;\n            max-width: 850px;\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);\n            border-radius: 8px;\n            overflow: hidden;\n            position: relative;\n        }\n\n        header {\n            background-color: var(--primary-color);\n            color: white;\n            padding: 40px;\n            text-align: center;\n        }\n\n        header h1 {\n            font-size: 2.5rem;\n            margin-bottom: 5px;\n            letter-spacing: 0.5px;\n        }\n\n        header .title {\n            font-size: 1.25rem;\n            font-weight: 300;\n            opacity: 0.9;\n            margin-bottom: 20px;\n        }\n\n        header .contact-info {\n            display: flex;\n            justify-content: center;\n            flex-wrap: wrap;\n            gap: 15px;\n            font-size: 0.9rem;\n        }\n\n        header .contact-info a {\n            color: white;\n            text-decoration: none;\n            display: flex;\n            align-items: center;\n            gap: 5px;\n            background: rgba(255, 255, 255, 0.2);\n            padding: 5px 12px;\n            border-radius: 20px;\n            transition: background 0.2s;\n        }\n\n        header .contact-info a:hover {\n            background: rgba(255, 255, 255, 0.3);\n        }\n\n        main {\n            padding: 40px;\n            display: grid;\n            grid-template-columns: 2fr 1fr;\n            gap: 40px;\n        }\n\n        section {\n            margin-bottom: 30px;\n        }\n\n        h2 {\n            font-size: 1.4rem;\n            color: var(--primary-color);\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            border-bottom: 2px solid var(--border-color);\n            padding-bottom: 10px;\n            margin-bottom: 20px;\n        }\n\n        h3 {\n            font-size: 1.1rem;\n            font-weight: 600;\n            color: #111827;\n        }\n\n        h4 {\n            font-size: 0.95rem;\n            font-weight: 500;\n            color: var(--text-muted);\n            margin-bottom: 8px;\n        }\n\n        p {\n            font-size: 0.95rem;\n            color: #4b5563;\n            margin-bottom: 10px;\n        }\n\n        a {\n            color: var(--primary-color);\n            text-decoration: none;\n            word-break: break-all;\n        }\n\n        a:hover {\n            text-decoration: underline;\n        }\n\n        .job-item, .project-item {\n            margin-bottom: 25px;\n            padding-left: 20px;\n            border-left: 3px solid var(--border-color);\n            transition: border-color 0.3s;\n        }\n\n        .job-item:hover, .project-item:hover {\n            border-left-color: var(--primary-color);\n        }\n\n        .job-item:last-child, .project-item:last-child {\n            margin-bottom: 0;\n        }\n\n        .skill-category-title {\n            font-size: 0.75rem;\n            font-weight: 700;\n            text-transform: uppercase;\n            color: var(--text-muted);\n            margin: 15px 0 8px 0;\n            letter-spacing: 0.5px;\n        }\n\n        .skills-list {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n\n        .skill-tag {\n            background-color: #e0e7ff;\n            color: #3730a3;\n            padding: 5px 10px;\n            border-radius: 4px;\n            font-size: 0.8rem;\n            font-weight: 500;\n        }\n\n        .cert-list {\n            list-style: none;\n        }\n\n        .cert-list li {\n            margin-bottom: 15px;\n            padding-bottom: 15px;\n            border-bottom: 1px dashed var(--border-color);\n        }\n\n        .cert-list li:last-child {\n            border-bottom: none;\n        }\n\n        .cert-link {\n            display: inline-block;\n            font-size: 0.85rem;\n            margin-top: 4px;\n            color: var(--text-muted);\n        }\n\n        .action-bar {\n            position: fixed;\n            bottom: 30px;\n            right: 30px;\n            z-index: 100;\n        }\n\n        .btn-print {\n            background-color: var(--primary-color);\n            color: white;\n            border: none;\n            width: 60px;\n            height: 60px;\n            border-radius: 50%;\n            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: transform 0.2s, background 0.2s;\n            font-size: 1.5rem;\n        }\n\n        .btn-print:hover {\n            transform: scale(1.1);\n            background-color: #1d4ed8;\n        }\n\n        @media (max-width: 768px) {\n            body {\n                padding: 0;\n            }\n\n            .resume-container {\n                box-shadow: none;\n                border-radius: 0;\n            }\n\n            main {\n                grid-template-columns: 1fr;\n                padding: 25px;\n            }\n\n            header {\n                padding: 30px 20px;\n            }\n        }\n\n        /* FIX: Print styles ÃÂ¢ÃÂÃÂ preserve two-column layout, fix link colours,\n           and only append URLs on body links (not header contact pills) */\n        @media print {\n            body {\n                background-color: white;\n                padding: 0;\n            }\n\n            .resume-container {\n                box-shadow: none;\n                max-width: 100%;\n            }\n\n            .action-bar {\n                display: none;\n            }\n\n            /* FIX: Keep links readable in print without clobbering colours */\n            a {\n                color: var(--primary-color);\n                text-decoration: none;\n            }\n\n            /* FIX: Only append href text on body/content links, NOT header contact pills */\n            main a[href^=\"http\"]::after,\n            main a[href^=\"mailto\"]::after {\n                content: \" (\" attr(href) \")\";\n                font-size: 0.75rem;\n                color: #666;\n            }\n\n            /* FIX: Preserve two-column grid in print */\n            main {\n                display: grid;\n                grid-template-columns: 2fr 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"resume-container\">\n        <header>\n            <h1>Muhammad Haji</h1>\n            <div class=\"title\">Software Developer</div>\n\n            <div class=\"contact-info\">\n                <a href=\"mailto:muhammad.ashaji1@gmail.com\">\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>\n                    muhammad.ashaji1@gmail.com\n                </a>\n                <!-- FIX: Added rel=\"noopener noreferrer\" to all target=\"_blank\" links (security) -->\n                <a href=\"https://portfolio-future-nine.vercel.app\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"></path><polyline points=\"15 3 21 3 21 9\"></polyline><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"></line></svg>\n                    Portfolio\n                </a>\n            </div>\n        </header>\n\n        <main>\n            <!-- Left Column -->\n            <div class=\"column-main\">\n\n                <section id=\"about\">\n                    <h2>Profile</h2>\n                    <p>\n                        Software Developer with a unique journey starting from 3D design with Blender and Unity to backend and frontend coding.\n                        Experienced in building practical solutions ranging from custom educational games for special needs students to complex\n                        email automation and AI integration. Currently advancing education in Computer Science, Physics, and Stats.\n                    </p>\n                </section>\n\n                <section id=\"experience\">\n                    <h2>Work Experience</h2>\n\n                    <div class=\"job-item\">\n                        <h3>Software Developer</h3>\n                        <h4>Working With Kebab O Clock</h4>\n                        <p>Built the company website from scratch. Currently working on implementing the payment gateway version to process transactions securely.</p>\n                        <a href=\"https://www.kebaboclock.co.uk\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.kebaboclock.co.uk</a>\n                    </div>\n\n                    <div class=\"job-item\">\n                        <h3>Software Developer</h3>\n                        <h4>Buried Blind Circuits</h4>\n                        <p>Developed Python IMAP email automation systems. Contributed to training AI models. Currently involved in Android application development.</p>\n                        <!-- FIX: URL corrected ÃÂ¢ÃÂÃÂ original had the display text and href mismatched\n                             (display said \"blindburiedcircuits.com\" but href was \"blindburiedcircuits.com\").\n                             Normalised to match the actual domain. -->\n                        <a href=\"https://blindburiedcircuits.com/\" target=\"_blank\" rel=\"noopener noreferrer\">https://blindburiedcircuits.com/</a>\n                    </div>\n\n                    <div class=\"job-item\">\n                        <h3>Game Developer</h3>\n                        <h4>Ujala (Parents Voice Association)</h4>\n                        <p>Created Python and HTML-based educational games specifically customized for special needs students to aid in their learning process.</p>\n                        <a href=\"https://parentsvoice-association.org\" target=\"_blank\" rel=\"noopener noreferrer\">https://parentsvoice-association.org</a>\n                    </div>\n                </section>\n\n                <section id=\"education\">\n                    <h2>Education</h2>\n\n                    <div class=\"job-item\">\n                        <h3>Nixor College</h3>\n                        <h4>Currently Enrolled (AS going to A2)</h4>\n                        <p>Subjects: Statistics, Computer Science, Physics.</p>\n                        <a href=\"https://www.nixorcollege.org\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.nixorcollege.org</a>\n                    </div>\n\n                    <div class=\"job-item\">\n                        <h3>British Overseas School(BOS)</h3>\n                        <h4>O-Levels Completed</h4>\n                        <p>Subjects: Mathematics, Physics, Biology, Chemistry, Computer Science, French, English Language/Literature, Urdu.</p>\n                        <a href=\"https://www.bos-karachi.org\" target=\"_blank\" rel=\"noopener noreferrer\">https://www.bos-karachi.org</a>\n                    </div>\n                </section>\n\n            </div>\n\n            <!-- Right Column (Sidebar) -->\n            <div class=\"column-sidebar\">\n\n                <section id=\"skills\">\n                    <h2>Technical Skills</h2>\n\n                    <div class=\"skill-category-title\">Web & Mobile Development</div>\n                    <div class=\"skills-list\">\n                        <span class=\"skill-tag\">HTML</span>\n                        <span class=\"skill-tag\">CSS</span>\n                        <span class=\"skill-tag\">JavaScript</span>\n                        <span class=\"skill-tag\">React</span>\n                        <span class=\"skill-tag\">Android Studio</span>\n                        <span class=\"skill-tag\">Firebase</span>\n                        <span class=\"skill-tag\">Cloudinary</span>\n                    </div>\n\n                    <div class=\"skill-category-title\">Languages & Databases</div>\n                    <div class=\"skills-list\">\n                        <span class=\"skill-tag\">Python</span>\n                        <span class=\"skill-tag\">Java</span>\n                        <span class=\"skill-tag\">SQL</span>\n                        <span class=\"skill-tag\">PostgreSQL</span>\n                        <span class=\"skill-tag\">Supabase</span>\n                    </div>\n\n                    <div class=\"skill-category-title\">Tools & Operating Systems</div>\n                    <div class=\"skills-list\">\n                        <span class=\"skill-tag\">Git & GitHub</span>\n                        <span class=\"skill-tag\">Blender</span>\n                        <span class=\"skill-tag\">Unity</span>\n                        <span class=\"skill-tag\">PowerShell</span>\n                        <span class=\"skill-tag\">Command Line</span>\n                        <span class=\"skill-tag\">Linux (Termux, XFCE, Ubuntu)</span>\n                        <span class=\"skill-tag\">Scratch</span>\n                    </div>\n                </section>\n\n                <section id=\"certifications\">\n                    <h2>Certifications & Awards</h2>\n                    <ul class=\"cert-list\">\n                        <li>\n                            <strong>Cisco Python Essentials 1</strong><br>\n                            <a href=\"https://www.credly.com/badges/a1a8f464-c055-4daf-bcfe-a170e8573b03\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Badge</a>\n                        </li>\n                        <li>\n                            <strong>Cisco Python Essentials 2</strong><br>\n                            <a href=\"https://www.credly.com/badges/448aaa60-2ae8-4855-bdb3-312d33a2a0b9\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Badge</a>\n                        </li>\n                        <li>\n                            <strong>Cisco JS Essentials 1</strong><br>\n                            <a href=\"https://www.credly.com/badges/251f5332-b1e9-4f9a-ba3b-363b86f6bd4a\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Badge</a>\n                        </li>\n                        <li>\n                            <strong>Partner: NDG Linux Essentials</strong><br>\n                            <span class=\"cert-link\">Linux system administration and command line essentials.</span><br>\n                            <a href=\"https://github.com/codemdragon/Portfolio_future/blob/main/certificates/Partner-_NDG_Linux_Essentials.pdf\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Certificate</a>\n                        </li>\n                        <li>\n                            <strong>Key Stage 4 Award (CS)</strong><br>\n                            <span class=\"cert-link\">Award for excellence in Computer Science upon graduating O-Levels.</span><br>\n                            <a href=\"https://github.com/codemdragon/Portfolio_future/blob/main/certificates/Keystage_4_Award_Cs.pdf\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Certificate</a>\n                        </li>\n                        <li>\n                            <strong>Ujala Project Certificate</strong><br>\n                            <span class=\"cert-link\">Proof of work for developing educational games.</span><br>\n                            <a href=\"https://github.com/codemdragon/Portfolio_future/blob/main/certificates/Ujala_cert.pdf\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Certificate</a>\n                        </li>\n                        <li>\n                            <strong>Cayley Contest</strong><br>\n                            <span class=\"cert-link\">Mathematics and Computing contest participation.</span><br>\n                            <a href=\"https://github.com/codemdragon/Portfolio_future/blob/main/certificates/Cayley_Contest_Cert.pdf\" class=\"cert-link\" target=\"_blank\" rel=\"noopener noreferrer\">View Certificate</a>\n                        </li>\n                        <li>\n                            <!-- FIX: Section title said \"Galois Contest\" but the PDF filename was\n                                 \"Golois_Contest_Cert.pdf\" (typo). Corrected filename to \"Galois_Contest_Cert.pdf\" -->\n                            <strong>Galois Contest</strong><br>\n                            <span class=\"cert-link\">Mathematics and Computing contest participation.</span><br>\n            